{
  "key": "",
  "manifest_version": 3,
  "name": "WebFPV Sync",
  "version": "3.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.webfpv.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
